[Unit]
Description=Project Delphi internship bot
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=%h/Projects/Delphi
ExecStart=%h/Projects/Delphi/.venv/bin/python bot.py
Environment=PYTHONUNBUFFERED=1
Restart=always
RestartSec=60

[Install]
WantedBy=default.target
