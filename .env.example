# Copy to .env (gitignored) and fill in.
ANTHROPIC_API_KEY=
# Form answers (what employers see) / ranking + Quercus scanning:
# DELPHI_MODEL=claude-opus-5-5
# DELPHI_FAST_MODEL=claude-haiku-5-5

# Make a bot with @BotFather. Send /start to it to get your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

DELPHI_TZ=America/Toronto
DIGEST_HOUR=8

# Quercus: Account > Settings > New Access Token. Course ids are the numbers in course URLs, comma separated.
CANVAS_URL=https://q.utoronto.ca
CANVAS_TOKEN=
CANVAS_COURSE_IDS=
# Discussion threads to scan, as course/topic from the thread URL, comma separated.
# CS Career and Research Opportunities: q.utoronto.ca/courses/221753/discussion_topics/1909917
CANVAS_DISCUSSIONS=221753/1909917

# Workday: one password for the account the bot makes on each company's Workday site.
# 8+ characters with upper, lower, number and symbol.
WORKDAY_PASSWORD=

# 0 = submit without showing you the filled form first. With /auto on, 0 makes it fully hands-off.
CONFIRM_BEFORE_SUBMIT=1
# Cover letters, written for each job by Claude and saved in cover_letters/: required = only where the form
# requires one, always = every cover letter upload, never = leave them empty.
# COVER_LETTER=required
# 0 = watch the browser fill forms
HEADLESS=1
# Phone view: set a password (max 8 characters, VNC's limit) and Telegram messages get a link that opens the
# bot's browser on your phone, to watch it or finish a form. Needs: sudo apt install xvfb x11vnc novnc
# The link works on your home Wi-Fi; to use it anywhere, install Tailscale on both and put this
# computer's Tailscale name in PHONE_VIEW_HOST.
VNC_PASSWORD=
PHONE_VIEW_HOST=
